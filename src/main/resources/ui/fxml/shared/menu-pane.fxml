<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="dev.tobiasbieber.mcmanager.ui.ctrl.impl.shared.MenuPane"
      stylesheets="@/ui/css/base.css, @/ui/css/theme-default.css"
      styleClass="menu-background"
      spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox>
        <padding>
            <Insets bottom="20"/>
        </padding>

        <Label text="%app.title"
               styleClass="app-title-text, mc-text"
               maxWidth="Infinity"
               alignment="CENTER"/>

        <Label text="%app.author"
               styleClass="muted-text, mc-text"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </VBox>

    <ToggleButton fx:id="worldButton"
                  styleClass="primary-toggle-button"
                  text="%menuPane.worldButton"
                  prefWidth="200"/>

    <ToggleButton fx:id="modButton"
                  styleClass="primary-toggle-button"
                  text="%menuPane.modButton"
                  prefWidth="200"/>

    <ToggleButton fx:id="resourcePackButton"
                  styleClass="primary-toggle-button"
                  text="%menuPane.resourcePackButton"
                  prefWidth="200"/>

    <ToggleButton fx:id="shaderPackButton"
                  styleClass="primary-toggle-button"
                  text="%menuPane.shaderPackButton"
                  prefWidth="200"/>

    <ToggleButton fx:id="settingsButton"
                  styleClass="primary-toggle-button"
                  text="%menuPane.settingsButton"
                  prefWidth="200"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Button fx:id="quitButton"
            styleClass="primary-button"
            text="%text.quit"
            prefWidth="200"/>

</VBox>