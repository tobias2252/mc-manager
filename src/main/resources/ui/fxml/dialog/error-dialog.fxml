<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="dev.tobiasbieber.mcmanager.ui.ctrl.impl.dialog.ErrorDialog"
            stylesheets="@/ui/css/base.css, @/ui/css/theme-default.css"
            styleClass="default-background">

    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="%dialog.errorOccurred"
                   styleClass="title-text, bold-text"/>

            <TextArea fx:id="stackTraceArea"
                      editable="false"
                      VBox.vgrow="ALWAYS"/>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10"
              styleClass="menu-background"
              alignment="BOTTOM_RIGHT">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button fx:id="okButton"
                    text="%text.ok"
                    prefWidth="150"/>

        </HBox>
    </bottom>

</BorderPane>