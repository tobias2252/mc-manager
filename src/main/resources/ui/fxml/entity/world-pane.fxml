<?xml version="1.0" encoding="UTF-8"?>

<?import dev.tobiasbieber.mcmanager.ui.view.entity.listview.WorldListView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="dev.tobiasbieber.mcmanager.ui.ctrl.impl.entity.WorldPane"
            stylesheets="@/ui/css/base.css, @/ui/css/theme-default.css"
            styleClass="default-background">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <HBox spacing="10">

            <padding>
                <Insets bottom="10"/>
            </padding>

            <Button fx:id="clearButton"
                    text="%text.clear"
                    prefWidth="150"/>

            <TextField fx:id="searchField"
                       promptText="%hint.search"
                       HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"/>

            <ComboBox fx:id="sortComboBox"
                      prefWidth="250"
                      maxHeight="Infinity"/>

        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <WorldListView fx:id="worldListView"
                           VBox.vgrow="ALWAYS"/>

            <GridPane vgap="10"
                      styleClass="boxed-background">

                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70"/>
                </columnConstraints>

                <Label text="%entity.path"
                       styleClass="bold-text"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <Label fx:id="pathLabel"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"/>

                <Label text="%world.gameType"
                       styleClass="bold-text"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <Label fx:id="gameTypeLabel"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

                <Label text="%world.difficulty"
                       styleClass="bold-text"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <Label fx:id="difficultyLabel"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"/>

                <Label text="%world.hardcore"
                       styleClass="bold-text"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <Label fx:id="hardcoreLabel"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"/>

                <Label text="%world.cheatsEnabled"
                       styleClass="bold-text"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <Label fx:id="cheatsEnabledLabel"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="4"/>

                <Label text="%world.seed"
                       styleClass="bold-text"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"/>

                <Label fx:id="seedLabel"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="5"/>

            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10">

            <padding>
                <Insets top="10"/>
            </padding>

            <Button fx:id="reloadButton"
                    text="%text.reload"
                    prefWidth="150"/>

            <Button fx:id="openFolderButton"
                    text="%text.openFolder"
                    prefWidth="150"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="backupButton"
                    text="%worldPane.manageBackups"
                    prefWidth="200"/>

            <Button fx:id="deleteButton"
                    styleClass="destructive-button"
                    text="%text.delete"
                    prefWidth="150"/>

        </HBox>
    </bottom>

</BorderPane>